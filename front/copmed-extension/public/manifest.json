{
    "manifest_version": 3,
    "version": "1.0.0",
    "name": "Copmed Extension",
    "action": {
        "default_popup": "index.html"
    },
    "background": {
        "service_worker": "background.js"
    },
    "minimum_chrome_version": "116",
    "permissions": [
        "scripting",
        "activeTab",
        "storage",
        "offscreen"
    ],
    "host_permissions": [
        "http://localhost:3001/*",
        "https://*.amplimed.com.br/*",
        "http://localhost:8081/*",
        "http://127.0.0.1:8081/*"
    ],
    "icons": {
        "32": "copilot-icon.png",
        "48": "CopMed_LogoBig.png",
        "128": "CopMed_LogoBig.png"
    },
    "content_scripts": [
        {
            "matches": [
                "https://*.amplimed.com.br/*",
                "http://localhost:8081/*",
                "http://127.0.0.1:8081/*"
            ],
            "js": ["content.js"],
            "all_frames": true
        }
    ]
}
